# Multi-Chain Monitor Bot Configuration
# Copy this to .env and fill in your values

# Required: Get from @BotFather
TELEGRAM_BOT_TOKEN="Enter bot token here"

# Optional: Your Telegram user ID for startup alerts
ADMIN_CHAT_ID="Enter id here and remove "" "

# Optional: TonAPI key for higher rate limits (https://tonconsole.com)
TON_API_KEY=

# Optional: Database path (default: data/monitor.db)
DB_PATH=data/monitor.db
# Optional JSON object of additional EVM networks. See README.
EXTRA_EVM_CHAINS=

# AUTO_DELETE_DELAY   Seconds before bot replies are automatically deleted (optional).
AUTO_DELETE_DELAY=30
